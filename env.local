# 第三方 API 密钥
# ====================================
# TMDB API
TMDB_API_KEY=eb817574a7755281fdf7e31b208ed222

# 管理员信息
ADMIN_USERNAME: admin
ADMIN_PASSWORD: admin123
ADMIN_EMAIL: admin@admin.com


# Google Books API
GOOGLE_BOOKS_API_KEY=AIzaSyCbtxdSnQc23coZ5965BdhVZancO3ttjq4

# Bangumi API（番组计划）
BANGUMI_API_KEY=sbwTRKA9pFwWkgJXHwcOdZtz4dnWzLT9uNuARKNO
BANGUMI_APP_ID=

# ====================================
# LLM API 配置
# ====================================
# 硅基流动 API (统一调用多个模型)
SILICONFLOW_API_KEY=sk-fpfkujeiymweioszopnpmbgqmjtabbkndbqvejxzwnwzczun
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek API (直连)
DEEPSEEK_API_KEY=sk-02753afa86ab41498310daf64354a301
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (直连)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API (直连)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认使用的 LLM 提供商 (siliconflow | deepseek | openai | claude)
DEFAULT_LLM_PROVIDER=siliconflow

# 默认使用的模型
DEFAULT_LLM_MODEL=deepseek-ai/DeepSeek-V3

# ====================================
# JWT 配置
# ====================================
JWT_SECRET_KEY=UwoBTgvJZFUGnSxV4kWvbMKxUefZs0myhax99YQAzgc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================================
# 邮件配置（可选）
# ====================================
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yueying.app

# ====================================
# 监控配置（可选）
# ====================================
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# ====================================
# 速率限制配置
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# 文件上传配置
# ====================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ====================================
# 系统设置配置
# ====================================
# 强制从环境变量读取系统设置并覆盖数据库
# 警告：设置为 true 时，每次启动会用环境变量覆盖数据库中的系统设置
FORCE_READ_ENV_SETTINGS=false

# 系统设置默认值（仅在数据库无设置或强制覆盖时生效）
DEFAULT_ENABLE_EXPLORE=false
DEFAULT_ALLOW_USER_AI_TAG_SETTINGS=true
