# ====================================
# 阅影·log（YueYing）环境变量配置模板
# ====================================
# 复制此文件为 .env 并填写实际的配置值

# ====================================
# 应用配置
# ====================================
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
NODE_ENV=development

# ====================================
# 数据库配置 (PostgreSQL)
# ====================================
POSTGRES_USER=yueying
POSTGRES_PASSWORD=yueying_dev_password
POSTGRES_DB=yueying
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yueying:yueying_dev_password@postgres:5432/yueying

# ====================================
# Redis 配置
# ====================================
REDIS_PASSWORD=yueying_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:yueying_redis_password@redis:6379/0

# ====================================
# MinIO 对象存储配置
# ====================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ====================================
# 服务端口配置
# ====================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ====================================
# CORS 配置
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost

# ====================================
# NextAuth 配置
# ====================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# ====================================
# API 配置
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ====================================
# 第三方 API 密钥
# ====================================
# TMDB API
TMDB_API_KEY=your-tmdb-api-key


# Google Books API
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Bangumi API
BANGUMI_API_KEY=your-Bangumi-api-key
BANGUMI_APP_ID=

# ====================================
# LLM API 配置
# ====================================
# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认使用的 LLM 提供商 (deepseek | openai | claude)
DEFAULT_LLM_PROVIDER=deepseek

# ====================================
# JWT 配置
# ====================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================================
# 邮件配置（可选）
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yueying.app

# ====================================
# 监控配置（可选）
# ====================================
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# ====================================
# 速率限制配置
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# 文件上传配置
# ====================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
