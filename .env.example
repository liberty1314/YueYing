# ====================================
# 阅影·log（YueYing）环境变量配置模板
# ====================================

# ====================================
# 配置管理
# ====================================
# 强制从环境变量读取 API 密钥配置并覆盖数据库
# 警告：设置为 true 时，每次启动会用环境变量覆盖数据库中的 API 密钥配置
# 适用场景：首次部署、密钥更新、配置同步
FORCE_ENV_SETTINGS=false

# 强制从环境变量读取系统设置并覆盖数据库
# 警告：设置为 true 时，每次启动会用环境变量覆盖数据库中的系统设置
FORCE_READ_ENV_SETTINGS=false

# ====================================
# 系统设置默认值
# ====================================
# 以下设置仅在数据库无设置或 FORCE_READ_ENV_SETTINGS=true 时生效
# 探索/推荐功能是否启动
DEFAULT_ENABLE_EXPLORE=false
# 是否允许允许用户自行设置 AI 自动标签
DEFAULT_ALLOW_USER_AI_TAG_SETTINGS=true
# 是否允许未登录用户访问首页
DEFAULT_ALLOW_ANONYMOUS_HOME_ACCESS=true

# ====================================
# 应用配置
# ====================================
APP_ENV=development
DEBUG=true
SECRET_KEY=7pFzcslRPJRUnysFNGdodcN460hWbsr46QN_D85AG3s
NODE_ENV=development

# ====================================
# 数据库配置 (PostgreSQL)
# ====================================
POSTGRES_USER=yueying
POSTGRES_PASSWORD=yueying
POSTGRES_DB=yueying
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yueying:yueying@postgres:5432/yueying

# ====================================
# Redis 配置
# ====================================
REDIS_PASSWORD=yueying
REDIS_PORT=6379
REDIS_URL=redis://:yueying@redis:6379/0

# ====================================
# MinIO 对象存储配置
# ====================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ====================================
# 服务端口配置
# ====================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ====================================
# 服务 URL 配置
# ====================================
# 前端 URL（用于 CORS 和重定向）
FRONTEND_URL=http://localhost:3000
# 后端 API URL（用于服务间通信）
BACKEND_URL=http://localhost:8000

# ====================================
# CORS 配置
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost

# ====================================
# NextAuth 配置
# ====================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CSrbALGZ-DID6KquoJYkzuQETnW3EcaHVFXKbXbZjD0

# ====================================
# API 配置
# ====================================
# 注意：NEXT_PUBLIC_API_URL 必须包含 /api 后缀
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ====================================
# 第三方 API 密钥
# ====================================
# TMDB API
TMDB_API_KEY=your-tmdb-api-key

# 管理员初始化信息（首次启动时创建管理员账户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Google Books API
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Bangumi API（番组计划）
BANGUMI_API_KEY=your-bangumi-api-key
BANGUMI_APP_ID=your-bangumi-app-id

# ====================================
# LLM API 配置
# ====================================
# 硅基流动 API (统一调用多个模型，推荐)
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek API (直连)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (直连)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API (直连)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认使用的 LLM 提供商 (siliconflow | deepseek | openai | claude)
DEFAULT_LLM_PROVIDER=siliconflow

# 默认使用的模型
DEFAULT_LLM_MODEL=deepseek-ai/DeepSeek-V3

# ====================================
# JWT 配置
# ====================================
JWT_SECRET_KEY=UwoBTgvJZFUGnSxV4kWvbMKxUefZs0myhax99YQAzgc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================================
# 未来功能（暂未实现）
# ====================================
# 邮件配置
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@yueying.app

# 监控配置（Sentry 错误追踪）
# SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=development

# ====================================
# 速率限制配置
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# API 文档配置
# ====================================
# 是否启用 API 文档（生产环境建议设为 false）
ENABLE_API_DOCS=true
# API 文档访问认证（可选，设置后需要基本认证才能访问文档）
# API_DOCS_USERNAME=admin
# API_DOCS_PASSWORD=your-secure-password

# ====================================
# 文件上传配置
# ====================================
MAX_UPLOAD_SIZE_MB=10

# ====================================
# 首页数据缓存配置
# ====================================
# 首页数据刷新时间（格式：HH:MM，例如 "01:00" 表示凌晨1点）
HOME_DATA_REFRESH_TIME=01:00
# 首页数据缓存过期时间（秒），默认 25 小时
HOME_DATA_CACHE_EXPIRE=90000