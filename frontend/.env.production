# ====================================
# YueYing Frontend - Production Environment
# ====================================
# 
# 生产环境配置文件
# 用于生产部署
# 
# 重要安全提示：
# 1. 所有密钥必须使用强随机字符串
# 2. 不要在公共仓库中暴露此文件
# 3. 使用环境变量管理工具（如 Docker secrets、K8s secrets）
# 4. 定期轮换密钥
# ====================================

# ====================================
# API 配置
# ====================================

# 服务器端 API URL
# Docker 环境：使用容器名称
# Kubernetes：使用 Service 名称
API_URL=http://backend:8000/api

# 客户端 API URL
# 必须是公网可访问的地址
# 示例：https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# WebSocket URL
# 生产环境使用 wss:// (安全 WebSocket)
# 示例：wss://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# ====================================
# 应用配置
# ====================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ====================================
# NextAuth 配置
# ====================================

# 应用完整 URL（必须使用 HTTPS）
NEXTAUTH_URL=https://your-domain.com

# NextAuth 密钥（必须更改！）
# 生成方法：openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION

# ====================================
# Next.js 配置
# ====================================

NEXT_TELEMETRY_DISABLED=1

# ====================================
# 功能开关 (生产环境关闭调试功能)
# ====================================

NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_VERBOSE_LOGGING=false

# ====================================
# 外部服务配置 (可选)
# ====================================

# Sentry DSN (错误追踪)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ====================================
# 性能优化
# ====================================

# 禁用源码映射（提高安全性）
GENERATE_SOURCEMAP=false

# 启用压缩
COMPRESS=true
