# ====================================
# YueYing Frontend Environment Variables
# ====================================
# 
# 本文件包含所有前端应用所需的环境变量配置示例
# 复制此文件为 .env.local (开发环境) 或 .env.production (生产环境)
# 
# 注意：
# - 以 NEXT_PUBLIC_ 开头的变量会暴露给浏览器客户端
# - 不以 NEXT_PUBLIC_ 开头的变量仅在服务器端可用
# - 敏感信息（如密钥）不应使用 NEXT_PUBLIC_ 前缀
# ====================================

# ====================================
# API 配置 (API Configuration)
# ====================================

# 服务器端 API URL
# 用于：Server Components、API Routes、NextAuth 等服务器端请求
# Docker 环境：使用容器名称 (http://backend:8000/api)
# 本地开发：使用 localhost (http://localhost:8000/api)
API_URL=http://backend:8000/api

# 客户端 API URL
# 用于：浏览器中的 fetch/axios 请求
# 必须是浏览器可访问的地址
# 开发环境：http://localhost:8000/api
# 生产环境：https://your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket URL (可选)
# 用于：实时通信（日志流、通知等）
# 如果不设置，会自动从 NEXT_PUBLIC_API_URL 推导
# 开发环境：ws://localhost:8000
# 生产环境：wss://your-domain.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ====================================
# 应用配置 (App Configuration)
# ====================================

# Node 环境
# 可选值：development | production | test
NODE_ENV=development

# 应用端口
# Next.js 开发服务器监听的端口
PORT=3000

# 主机名
# 生产环境建议设置为 0.0.0.0 以接受所有网络接口的连接
HOSTNAME=0.0.0.0

# ====================================
# NextAuth 配置 (Authentication)
# ====================================

# NextAuth URL
# 应用的完整 URL（包括协议和域名）
# 开发环境：http://localhost:3000
# 生产环境：https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth 密钥
# 用于加密 session 和 JWT token
# 生产环境必须更改为强随机字符串
# 生成方法：openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-in-production

# ====================================
# Next.js 配置 (Next.js Settings)
# ====================================

# 禁用 Next.js 遥测
# 设置为 1 可禁用匿名使用数据收集
NEXT_TELEMETRY_DISABLED=1

# ====================================
# 功能开关 (Feature Flags)
# ====================================

# 启用调试模式
# 开发环境：true，生产环境：false
NEXT_PUBLIC_DEBUG=false

# 启用性能监控
# 用于 Web Vitals 和性能指标收集
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ====================================
# 外部服务配置 (External Services)
# ====================================

# Sentry DSN (错误追踪，可选)
# NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID (可选)
# NEXT_PUBLIC_GA_ID=

# ====================================
# 开发工具配置 (Development Tools)
# ====================================

# 启用 React DevTools
# 生产环境应设置为 false
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# 启用详细日志
# 开发环境：true，生产环境：false
NEXT_PUBLIC_VERBOSE_LOGGING=true
