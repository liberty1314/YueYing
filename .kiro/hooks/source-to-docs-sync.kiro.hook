{
  "enabled": false,
  "name": "Source to Docs Sync",
  "description": "Monitors all source files (Python, TypeScript, JavaScript, configuration files) in the repository and triggers documentation updates in README.md or /docs folder when changes are detected",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/app/**/*.py",
      "backend/alembic/**/*.py",
      "backend/scripts/**/*.py",
      "frontend/app/**/*.{ts",
      "tsx",
      "js",
      "jsx}",
      "frontend/components/**/*.{ts",
      "tsx}",
      "frontend/lib/**/*.{ts",
      "tsx}",
      "frontend/hooks/**/*.{ts",
      "tsx}",
      "frontend/store/**/*.{ts",
      "tsx}",
      "frontend/types/**/*.{ts",
      "tsx}",
      "backend/requirements.txt",
      "frontend/package.json",
      "docker-compose.yml",
      "Makefile",
      "*.config.{js",
      "ts}",
      "tsconfig.json",
      "alembic.ini"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code files have been modified. Please review the changes and update the relevant documentation:\n\n1. If the changes affect the overall architecture or major features, update the main README.md\n2. If the changes are backend-specific, update backend/README.md or create/update files in backend/docs/\n3. If the changes are frontend-specific, update frontend/README.md or create/update files in frontend/docs/\n4. If the changes affect the project structure, update docs/ folder with appropriate documentation\n5. Ensure documentation includes:\n   - Updated API endpoints or function signatures\n   - New features or capabilities\n   - Changed configuration options\n   - Updated setup or deployment instructions\n   - Any breaking changes or migration notes\n\nFocus on keeping documentation accurate, clear, and synchronized with the codebase."
  }
}