# ====================================
# 阅影·log 后端环境变量配置模板
# ====================================
# 
# 注意：
# - Docker 环境：使用根目录的 .env 文件，此文件不需要
# - 本地开发：复制此文件为 .env 并填写实际的配置值
# 
# 推荐使用 Docker 环境进行开发，配置更简单统一

# ====================================
# 应用配置
# ====================================
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production

# ====================================
# 数据库配置
# ====================================
DATABASE_URL=postgresql://yueying:yueying_dev_password@postgres:5432/yueying

# ====================================
# Redis 配置
# ====================================
REDIS_URL=redis://:yueying@redis:6379/0

# ====================================
# MinIO 配置
# ====================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ====================================
# JWT 配置
# ====================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================
# CORS 配置
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost

# ====================================
# 第三方 API 密钥
# ====================================
TMDB_API_KEY=your-tmdb-api-key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ====================================
# LLM API 配置
# ====================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

DEFAULT_LLM_PROVIDER=deepseek

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================================
# 速率限制配置
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# 文件上传配置
# ====================================
MAX_UPLOAD_SIZE_MB=10

# ====================================
# 系统设置默认值
# ====================================
# 强制从环境变量读取系统设置（覆盖数据库配置）
FORCE_READ_ENV_SETTINGS=false

# 系统功能开关默认值
DEFAULT_ENABLE_EXPLORE=false
DEFAULT_ALLOW_USER_AI_TAG_SETTINGS=true
DEFAULT_ALLOW_ANONYMOUS_HOME_ACCESS=true
DEFAULT_ENABLE_STATS=true
DEFAULT_ENABLE_AI_ASSISTANT=true
